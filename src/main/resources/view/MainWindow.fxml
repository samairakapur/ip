<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="Infinity" maxWidth="Infinity" minHeight="220.0" minWidth="417.0"
            prefHeight="600.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="leo.MainWindow">
    <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="1.0"
                AnchorPane.rightAnchor="1.0" AnchorPane.topAnchor="1.0">
        <VBox fx:id="dialogContainer" prefWidth="400.0" spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
        </VBox>
    </ScrollPane>

    <TextField fx:id="userInput" onAction="#handleUserInput" promptText="Type a command, e.g. list"
               prefHeight="41.0"
               AnchorPane.bottomAnchor="1.0" AnchorPane.leftAnchor="1.0"
               AnchorPane.rightAnchor="86.4"/>

    <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
            prefHeight="41.0" prefWidth="87.4" text="Send"
            AnchorPane.bottomAnchor="1.0" AnchorPane.rightAnchor="1.0"/>
</AnchorPane>
